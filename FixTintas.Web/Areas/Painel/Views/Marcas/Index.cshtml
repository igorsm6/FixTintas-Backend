@model List<MarcaDto>
@{
    ViewData["Title"] = "Marcas";
}

<div class="barra-topo">
    <h1>Marcas</h1>
    <a class="btn btn-primario" asp-action="Criar">+ Nova marca</a>
</div>

<p class="ajuda">Aparecem no menu "Marcas" da loja e no app. Marca com produtos não é apagada: fica inativa.</p>

<div class="tabela-wrap">
    <table>
        <thead>
            <tr><th>Marca</th><th>Descrição</th><th>Status</th><th>Ações</th></tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="4" class="vazio">Nenhuma marca cadastrada.</td></tr>
            }
            @foreach (var m in Model)
            {
                <tr>
                    <td><strong>@m.Nome</strong></td>
                    <td>@m.Descricao</td>
                    <td><span class="badge @(m.Inativa ? "inativo" : "ok")">@(m.Inativa ? "Inativa" : "Ativa")</span></td>
                    <td>
                        <div class="acoes">
                            <a class="btn btn-secundario btn-sm" asp-action="Editar" asp-route-id="@m.Id">Editar</a>
                            <form asp-action="Excluir" asp-route-id="@m.Id" method="post" data-confirmar="Excluir a marca &quot;@m.Nome&quot;?">
                                <button type="submit" class="btn btn-perigo btn-sm">Excluir</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

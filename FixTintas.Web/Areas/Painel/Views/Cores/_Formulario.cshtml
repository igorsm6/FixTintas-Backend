@model CorSalvarDto
@* Partial view: os campos da cor, usados em Criar e em Editar. *@

<div asp-validation-summary="ModelOnly" class="alerta erro" role="alert"></div>

<div class="grid-form">
    <div class="campo span2">
        <label asp-for="Nome"></label>
        <input asp-for="Nome" placeholder="Ex.: Azul Oceano" />
        <span asp-validation-for="Nome" class="erro"></span>
    </div>

    <div class="campo">
        <label asp-for="CodigoHex"></label>
        @* O seletor de cor e o campo de texto ficam sincronizados (painel.js). *@
        <div class="linha-cor">
            <input type="color" id="seletor-cor" value="@Model.CodigoHex" aria-label="Escolher a cor" data-sincroniza="CodigoHex" />
            <input asp-for="CodigoHex" class="maiusculas" placeholder="#RRGGBB" maxlength="7" />
        </div>
        <span asp-validation-for="CodigoHex" class="erro"></span>
    </div>

    <div class="campo">
        <label asp-for="Familia"></label>
        <input asp-for="Familia" placeholder="Ex.: Azul" list="familias-de-cor" />
        <datalist id="familias-de-cor">
            <option value="Branco"></option>
            <option value="Neutro"></option>
            <option value="Cinza"></option>
            <option value="Azul"></option>
            <option value="Verde"></option>
            <option value="Amarelo"></option>
            <option value="Laranja"></option>
            <option value="Vermelho"></option>
            <option value="Rosa"></option>
            <option value="Roxo"></option>
        </datalist>
        <span asp-validation-for="Familia" class="erro"></span>
    </div>

    <div class="campo">
        <label asp-for="CodigoPantone"></label>
        <input asp-for="CodigoPantone" placeholder="Opcional" />
        <span asp-validation-for="CodigoPantone" class="erro"></span>
    </div>

    <div class="campo span2">
        <label class="check"><input asp-for="Inativa" /> @Html.DisplayNameFor(m => m.Inativa)</label>
    </div>
</div>

@model CategoriaSalvarDto
@* Partial view: os campos da categoria, usados em Criar e em Editar. *@

<div asp-validation-summary="ModelOnly" class="alerta erro" role="alert"></div>

<div class="grid-form">
    <div class="campo span2">
        <label asp-for="Nome"></label>
        <input asp-for="Nome" />
        <span asp-validation-for="Nome" class="erro"></span>
    </div>

    <div class="campo">
        <label asp-for="CategoriaPaiId"></label>
        <select asp-for="CategoriaPaiId" asp-items="@((SelectList)ViewData["Pais"]!)">
            <option value="">— Nenhuma (é uma categoria principal) —</option>
        </select>
        <p class="ajuda">O menu tem dois níveis: escolha a principal para criar uma subcategoria.</p>
    </div>

    <div class="campo">
        <label asp-for="Ordem"></label>
        <input asp-for="Ordem" type="number" min="0" max="999" step="1" />
        <span asp-validation-for="Ordem" class="erro"></span>
    </div>

    <div class="campo span2">
        <label asp-for="Slug"></label>
        <input asp-for="Slug" placeholder="Vazio = gerado a partir do nome" />
        <p class="ajuda">É o pedaço do endereço da loja: /Produtos?categoria=<strong>exterior-vernizes</strong>. Use letras minúsculas, números e hífen.</p>
        <span asp-validation-for="Slug" class="erro"></span>
    </div>

    <div class="campo span2">
        <label class="check"><input asp-for="Inativa" /> @Html.DisplayNameFor(m => m.Inativa)</label>
    </div>
</div>

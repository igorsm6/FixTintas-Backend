@model List<CategoriaDto>
@{
    ViewData["Title"] = "Categorias";
}

<div class="barra-topo">
    <h1>Categorias</h1>
    <a class="btn btn-primario" asp-action="Criar">+ Nova categoria</a>
</div>

<p class="ajuda">
    São as categorias do menu lateral da loja (dois níveis: categoria principal e subcategoria).
    Categoria com produtos ou subcategorias não é apagada: fica inativa (some da loja).
</p>

<div class="tabela-wrap">
    <table>
        <thead>
            <tr><th>Nome</th><th>Endereço (slug)</th><th>Ordem</th><th>Status</th><th>Ações</th></tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="5" class="vazio">Nenhuma categoria cadastrada.</td></tr>
            }
            @foreach (var c in Model)
            {
                <tr class="@(c.CategoriaPaiId is null ? "linha-principal" : "linha-sub")">
                    <td>
                        @if (c.CategoriaPaiId is null)
                        {
                            <strong>@c.Nome</strong>
                        }
                        else
                        {
                            <span class="recuo">↳ @c.Nome</span><span class="sub">em @c.CategoriaPaiNome</span>
                        }
                    </td>
                    <td><code>@c.Slug</code></td>
                    <td>@c.Ordem</td>
                    <td><span class="badge @(c.Inativa ? "inativo" : "ok")">@(c.Inativa ? "Inativa" : "Ativa")</span></td>
                    <td>
                        <div class="acoes">
                            <a class="btn btn-secundario btn-sm" asp-action="Editar" asp-route-id="@c.Id">Editar</a>
                            <form asp-action="Excluir" asp-route-id="@c.Id" method="post" data-confirmar="Excluir a categoria &quot;@c.Nome&quot;?">
                                <button type="submit" class="btn btn-perigo btn-sm">Excluir</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@model FuncionarioCriarDto
@{
    ViewData["Title"] = "Novo funcionário";
}

<div class="barra-topo">
    <h1>Novo funcionário</h1>
    <a asp-action="Index">‹ Voltar para a lista</a>
</div>

<form asp-action="Criar" method="post" class="cartao-form cartao-pequeno" autocomplete="off">
    <div asp-validation-summary="ModelOnly" class="alerta erro" role="alert"></div>

    <div class="grid-form">
        <div class="campo span2">
            <label asp-for="Nome"></label>
            <input asp-for="Nome" />
            <span asp-validation-for="Nome" class="erro"></span>
        </div>

        <div class="campo span2">
            <label asp-for="Email"></label>
            <input asp-for="Email" type="email" />
            <span asp-validation-for="Email" class="erro"></span>
        </div>

        <div class="campo span2">
            <label asp-for="Perfil"></label>
            <select asp-for="Perfil">
                <option value="@Perfis.Funcionario">Funcionário (produtos, estoque e pedidos)</option>
                <option value="@Perfis.Gerente">Gerente (também preços, exclusões, catálogo, cupons e equipe)</option>
            </select>
            <span asp-validation-for="Perfil" class="erro"></span>
        </div>

        <div class="campo span2">
            <label asp-for="SenhaTemporaria"></label>
            <div class="linha-senha">
                <input asp-for="SenhaTemporaria" type="text" placeholder="Vazio = o sistema gera uma" autocomplete="off" />
                <button type="button" class="btn btn-secundario" data-gerar-senha="SenhaTemporaria">Gerar</button>
            </div>
            <p class="ajuda">Mínimo de 8 caracteres, com letras e números. O funcionário troca no primeiro acesso.</p>
            <span asp-validation-for="SenhaTemporaria" class="erro"></span>
        </div>
    </div>

    <div class="modal-rodape">
        <a class="btn btn-secundario" asp-action="Index">Cancelar</a>
        <button type="submit" class="btn btn-primario">Criar funcionário</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model ProdutoSalvarDto
@{
    ViewData["Title"] = "Editar produto";
}

<div class="barra-topo">
    <h1>Editar produto</h1>
    <a asp-action="Index">‹ Voltar para a lista</a>
</div>

@* O id vai na URL (/Painel/Produtos/Editar/5), não dentro do formulário. *@
<form asp-action="Editar" asp-route-id="@ViewData["Id"]" method="post" enctype="multipart/form-data" class="cartao-form" data-formulario-produto>
    <partial name="_Formulario" model="Model" />
    <div class="modal-rodape">
        <a class="btn btn-secundario" asp-action="Index">Cancelar</a>
        <button type="submit" class="btn btn-primario">Salvar alterações</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

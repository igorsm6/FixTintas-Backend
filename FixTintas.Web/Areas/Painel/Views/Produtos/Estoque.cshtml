@model List<ProdutoDto>
@{
    ViewData["Title"] = "Controle de estoque";
    var busca = ViewData["Busca"] as string;
}

<div class="barra-topo">
    <h1>Controle de estoque</h1>
    <form asp-action="Estoque" method="get" class="busca-estoque">
        <input type="search" name="busca" value="@busca" placeholder="Buscar produto..." aria-label="Buscar produto" />
    </form>
</div>

<p class="ajuda">
    Digite a quantidade contada na prateleira e clique em Salvar. Linhas em amarelo estão com estoque baixo;
    em vermelho, zerado. As vendas (site e app) baixam o estoque sozinhas, pela trigger do banco.
</p>

<div class="tabela-wrap">
    <table>
        <thead>
            <tr><th>Produto</th><th>Mínimo</th><th>Quantidade</th><th></th></tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="4" class="vazio">Nenhum produto encontrado.</td></tr>
            }
            @foreach (var p in Model)
            {
                var idFormulario = $"estoque-{p.Id}";
                <tr class="@(p.Situacao == "ok" ? null : "linha-" + p.Situacao)">
                    <td>
                        <strong>@p.Nome</strong> <span class="badge @p.Situacao">@(p.Situacao switch { "zerado" => "Sem estoque", "baixo" => "Estoque baixo", _ => "Em estoque" })</span>
                        <span class="sub">@(p.Inativo ? $"{p.Rotulo} · {p.Sku} · oculto na loja" : $"{p.Rotulo} · {p.Sku}")</span>
                    </td>
                    <td>@p.EstoqueMinimo</td>
                    <td>
                        @* Cada linha tem o seu formulário (o campo aponta para ele pelo atributo form). *@
                        <form id="@idFormulario" asp-action="AtualizarEstoque" asp-route-id="@p.Id" method="post">
                            <input type="hidden" name="busca" value="@busca" />
                        </form>
                        <input type="number" form="@idFormulario" name="estoque" value="@p.Estoque" min="0" max="1000000" step="1"
                               class="input-qtd" aria-label="Quantidade de @p.Nome" required />
                    </td>
                    <td><button type="submit" form="@idFormulario" class="btn btn-primario btn-sm">Salvar</button></td>
                </tr>
            }
        </tbody>
    </table>
</div>

@*
    Avisos rápidos que os controllers deixam no TempData antes de redirecionar:
      TempData["Mensagem"] = "Produto adicionado ao carrinho!";   (verde-azulado)
      TempData["Erro"]     = "Este cupom expirou.";               (vermelho)
    O TempData dura só até a próxima página, então o aviso aparece uma vez.
*@
@{
    var mensagem = TempData["Mensagem"] as string;
    var erro = TempData["Erro"] as string;
}
@if (!string.IsNullOrEmpty(mensagem) || !string.IsNullOrEmpty(erro))
{
    <div class="fx-avisos">
        @if (!string.IsNullOrEmpty(erro))
        {
            <div class="fx-aviso erro" role="alert" data-some-sozinho>
                <span>@erro</span>
                <button type="button" class="fx-aviso-fechar" aria-label="Fechar">✕</button>
            </div>
        }
        @if (!string.IsNullOrEmpty(mensagem))
        {
            <div class="fx-aviso" role="status" data-some-sozinho>
                <span>@mensagem</span>
                <button type="button" class="fx-aviso-fechar" aria-label="Fechar">✕</button>
            </div>
        }
    </div>
}

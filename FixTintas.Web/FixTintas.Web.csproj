<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- WEB: o site da loja e o painel do funcionário, em ASP.NET Core MVC (Razor). Chama só o Negocio. -->
  <ItemGroup>
    <ProjectReference Include="..\FixTintas.Modelos\FixTintas.Modelos.csproj" />
    <ProjectReference Include="..\FixTintas.Negocio\FixTintas.Negocio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- O app Android (.apk) que o site oferece em /App: vai junto quando o site é publicado. -->
  <ItemGroup>
    <None Update="Aplicativo\**" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <!-- Roda no .NET 9; se a máquina só tiver o .NET 10, usa o 10 sem precisar mudar nada. -->
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- API: a única API do sistema, em JSON, para o aplicativo Flutter. Chama só o Negocio. -->
  <ItemGroup>
    <ProjectReference Include="..\FixTintas.Modelos\FixTintas.Modelos.csproj" />
    <ProjectReference Include="..\FixTintas.Negocio\FixTintas.Negocio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Login do app com token (JWT) -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.*" />
    <!-- Documentação OpenAPI (/openapi/v1.json) -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.*" />
    <!-- O que o comando "dotnet ef" precisa -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- O que faz o Update-Database funcionar no Visual Studio -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Tela gráfica para testar os endpoints (/scalar) -->
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.13" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <!-- Roda no .NET 9; se a máquina só tiver o .NET 10, usa o 10 sem precisar mudar nada. -->
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
